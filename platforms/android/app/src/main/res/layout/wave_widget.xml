<?xml version="1.0" encoding="utf-8"?>
<!-- One line of what is playing, and one button. Home screens reward restraint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="horizontal"
  android:gravity="center_vertical"
  android:padding="12dp"
  android:background="#1B2030">
  <ImageView
    android:id="@+id/widget_mark"
    android:layout_width="26dp"
    android:layout_height="26dp"
    android:src="@drawable/wave_mark"
    android:contentDescription="@string/app_name"/>
  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <TextView
      android:id="@+id/widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:ellipsize="end"
      android:textColor="#EEF1F8"
      android:textSize="14sp"
      android:text="@string/widget_idle"/>
    <TextView
      android:id="@+id/widget_artist"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:ellipsize="end"
      android:textColor="#A9B0C0"
      android:textSize="12sp"/>
  </LinearLayout>
  <TextView
    android:id="@+id/widget_toggle"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:gravity="center"
    android:text="⏯"
    android:textSize="18sp"
    android:textColor="#EEF1F8"
    android:contentDescription="@string/widget_toggle"/>
</LinearLayout>
