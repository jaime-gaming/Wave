<?xml version="1.0" encoding="utf-8"?>
<!-- Long press the icon: the three things a music app is opened for. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
  <shortcut
    android:shortcutId="search"
    android:enabled="true"
    android:icon="@drawable/wave_mark"
    android:shortcutShortLabel="@string/shortcut_search"
    android:shortcutLongLabel="@string/shortcut_search_long">
    <intent
      android:action="android.intent.action.VIEW"
      android:targetPackage="io.github.jaimegaming.wave"
      android:targetClass="io.github.jaimegaming.wave.MainActivity">
      <extra android:name="wave.destination" android:value="search"/>
    </intent>
  </shortcut>
  <shortcut
    android:shortcutId="remix"
    android:enabled="true"
    android:icon="@drawable/wave_mark"
    android:shortcutShortLabel="@string/shortcut_remix"
    android:shortcutLongLabel="@string/shortcut_remix_long">
    <intent
      android:action="android.intent.action.VIEW"
      android:targetPackage="io.github.jaimegaming.wave"
      android:targetClass="io.github.jaimegaming.wave.MainActivity">
      <extra android:name="wave.destination" android:value="remix"/>
    </intent>
  </shortcut>
  <shortcut
    android:shortcutId="favorites"
    android:enabled="true"
    android:icon="@drawable/wave_mark"
    android:shortcutShortLabel="@string/shortcut_favorites"
    android:shortcutLongLabel="@string/shortcut_favorites_long">
    <intent
      android:action="android.intent.action.VIEW"
      android:targetPackage="io.github.jaimegaming.wave"
      android:targetClass="io.github.jaimegaming.wave.MainActivity">
      <extra android:name="wave.destination" android:value="favorites"/>
    </intent>
  </shortcut>
</shortcuts>
