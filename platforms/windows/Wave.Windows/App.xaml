    <PathGeometry x:Key="IconSettings" Figures="M7 4.2v4.6 M7 13.2v6.6 M12 4.2v9.2 M12 18v1.8 M17 4.2v2.4 M17 11v8.8 M4.7 10.9h4.6 M9.7 15.9h4.6 M14.7 9h4.6"/>
    <PathGeometry x:Key="IconChevronDown" Figures="M6.3 9.5 12 15.2l5.7-5.7"/>
    <PathGeometry x:Key="IconChevronLeft" Figures="M14.5 5.9 8.4 12l6.1 6.1"/>
    <PathGeometry x:Key="IconChevronRight" Figures="M9.5 5.9 15.6 12l-6.1 6.1"/>
    <PathGeometry x:Key="IconDisc" Figures="M20.7 14.3a9 9 0 1 1-1.3-6.5 M15.2 12.6a3.4 3.4 0 1 1-2.6-2.9"/>
    <PathGeometry x:Key="IconArtist" Figures="M5.9 8.4a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0 -7 0 M3.6 19.6c0-3.2 2.6-5.3 5.8-5.3s5.8 2.1 5.8 5.3 M15.7 5.3a3.5 3.5 0 0 1 0 6.2 M17.4 14.7c1.9.5 3 2 3 4.3"/>
    <PathGeometry x:Key="IconPlay" Figures="M7.7 4.9c0-.9 1-1.4 1.7-.9l9 6.2c.7.5.7 1.5 0 2l-9 6.2c-.7.5-1.7 0-1.7-.9Z"/>
    <PathGeometry x:Key="IconPause" Figures="M9.3 6.5v11 M14.7 6.5v11"/>
    <PathGeometry x:Key="IconPrevious" Figures="M6.1 5.8v12.4 M18.4 6.4v11.2a.9.9 0 0 1-1.4.7l-8-5.5a.9.9 0 0 1 0-1.6l8-5.5a.9.9 0 0 1 1.4.7Z"/>
    <PathGeometry x:Key="IconNext" Figures="M17.9 5.8v12.4 M5.6 6.4v11.2a.9.9 0 0 0 1.4.7l8-5.5a.9.9 0 0 0 0-1.6l-8-5.5a.9.9 0 0 0-1.4.7Z"/>
    <PathGeometry x:Key="IconShuffle" Figures="M4 6.9h2.5c1.4 0 2.7.7 3.5 1.9l3.9 6.4c.8 1.2 2.1 1.9 3.5 1.9H20 M4 17.1h2.5c1.4 0 2.7-.7 3.5-1.9l3.9-6.4c.8-1.2 2.1-1.9 3.5-1.9H20 M17.7 4.6 20.2 6.9l-2.5 2.3 M17.7 14.8 20.2 17.1l-2.5 2.3"/>
    <PathGeometry x:Key="IconRepeat" Figures="M6.6 7.2h10.9a2.5 2.5 0 0 1 2.5 2.5v2.4 M17.4 16.8H6.5A2.5 2.5 0 0 1 4 14.3v-2.4 M8.4 4.7 6 7.2l2.4 2.5 M15.6 19.3 18 16.8l-2.4-2.5"/>
    <PathGeometry x:Key="IconHeart" Figures="M12 20.1c-3.6-2.5-7.7-5.4-7.7-9.4a4 4 0 0 1 7.3-2.4c.2.3.6.3.8 0a4 4 0 0 1 7.3 2.4c0 4-4.1 6.9-7.7 9.4Z"/>
    <PathGeometry x:Key="IconLyrics" Figures="M6.1 5.3h11.8a3.2 3.2 0 0 1 3.2 3.2v7a3.2 3.2 0 0 1 -3.2 3.2h-11.8a3.2 3.2 0 0 1 -3.2 -3.2v-7a3.2 3.2 0 0 1 3.2 -3.2Z M9.9 10.3H8a1.7 1.7 0 0 0-1.7 1.7v1.4A1.7 1.7 0 0 0 8 15.1h1.9 M16.4 10.3h-1.9a1.7 1.7 0 0 0-1.7 1.7v1.4a1.7 1.7 0 0 0 1.7 1.7h1.9"/>
    <PathGeometry x:Key="IconEdit" Figures="M4.9 19.1l.8-4L15.4 5.4a2 2 0 0 1 2.8 0l.5.5a2 2 0 0 1 0 2.8L8.9 18.3l-4 .8Z M13.9 7.1l3 3"/>
    <PathGeometry x:Key="IconQueue" Figures="M4 6.6h10.2 M4 11.3h7.4 M4 16h5.4 M14.9 16.5a2.3 2.3 0 1 0 4.6 0a2.3 2.3 0 1 0 -4.6 0 M19.5 16.5V7.6"/>
    <PathGeometry x:Key="IconArrowUpRight" Figures="M7.4 16.6 16.5 7.5 M9.4 7.5h7.1v7.1"/>

    <!-- The icon inside a button: stroked, round-capped, tinted by the button. -->
    <Style x:Key="IconPath" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
      <Setter Property="StrokeThickness" Value="1.7"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource TonalBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="MinWidth" Value="42"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="21" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.84"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.66"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The accented call to action: adding music, playing a collection. -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentTonalBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- Transport and utility buttons: a shape, no words. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="MinWidth" Value="42"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="21">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource TonalBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.66"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The two buttons beside a page title, matching the browser's circles. -->
    <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="Margin" Value="0,0,0,0"/>
      <Setter Property="Background" Value="{DynamicResource AccentTonalBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- The one filled circle: the button that starts or stops the music. -->
    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="56"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="MinHeight" Value="56"/>
      <Setter Property="MinWidth" Value="56"/>
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="28">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Navigation: a label that lights up, not a box that is always full. -->
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- The hover is a layer that fades in rather than a colour that swaps,
                 and the row slides a touch as it lights up: the same small weight
                 the web navigation has. Nothing here is a hard cut. -->
            <Grid RenderTransformOrigin="0,0.5">
              <Grid.RenderTransform><TranslateTransform x:Name="Slide" X="0"/></Grid.RenderTransform>
              <Border x:Name="Hover" Background="{DynamicResource TonalBrush}" CornerRadius="14" Opacity="0"/>
              <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                      <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="Padding" Value="2,3"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Scrollbars are a hint, not furniture: no arrows, no groove, no grey box. -->
    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" Margin="1">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Thumb" Background="{DynamicResource MutedBrush}" Opacity="0.26" CornerRadius="4" Margin="2,0"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent" Margin="1">
                  <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb>
                        <Thumb.Template>
                          <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Thumb" Background="{DynamicResource MutedBrush}" Opacity="0.26" CornerRadius="4" Margin="2,0"/>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Seek and volume: a thin groove, the played part in the accent, a round grip. -->
    <Style x:Key="WaveSlider" TargetType="Slider">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center" Background="Transparent">
              <Border Height="6" CornerRadius="3" Background="{DynamicResource TonalBrush}" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3,0,0,3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" Background="Transparent" VerticalAlignment="Center"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="14">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource BackgroundBrush}"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
    <Style TargetType="Slider" BasedOn="{StaticResource WaveSlider}"/>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/>
      <Setter Property="SelectionBrush" Value="#516D9E"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TonalBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- No colour here on purpose: text takes the colour of whatever it sits in,
         so a quiet label inside an accented row stays quiet instead of turning. -->
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource WaveFont}"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Margin" Value="4,14"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource TonalBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
