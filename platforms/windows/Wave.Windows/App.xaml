<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Wave.Windows.App">
  <Application.Resources>
    <!-- Colours live in the merged dictionary App.Brushes builds, so a theme change
         is one dictionary swap and every DynamicResource follows. The typeface is the
         same four files the browser's typeface comes from, resolved out of the
         Assets folder. If the family cannot be resolved WPF falls back to its own
         default face rather than failing to draw. -->
    <FontFamily x:Key="WaveFont">pack://application:,,,/Assets/#Nunito Sans</FontFamily>

    <!-- The icons, as line drawings on the browser's 24-unit grid. They are here so
         the XAML below and the lists the window builds in code draw the same shapes,
         and so nothing depends on an icon font being installed. -->
