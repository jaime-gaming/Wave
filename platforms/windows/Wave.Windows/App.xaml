    <PathGeometry x:Key="IconLibrary" Figures="M9.6 4.4h6.9a2.2 2.2 0 0 1 2.2 2.2v6.9 M6.3 8.2h6.4a2.9 2.9 0 0 1 2.9 2.9v5.7a2.9 2.9 0 0 1 -2.9 2.9h-6.4a2.9 2.9 0 0 1 -2.9 -2.9v-5.7a2.9 2.9 0 0 1 2.9 -2.9Z M7.3 14a2.2 2.2 0 1 0 4.4 0a2.2 2.2 0 1 0 -4.4 0"/>
