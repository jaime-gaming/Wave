<?xml version="1.0" ?>
<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Wave.Windows.App" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#324773"/>
      <Setter Property="Foreground" Value="#E3E5F1"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#282E3E"/>
      <Setter Property="Foreground" Value="#E3E5F1"/>
      <Setter Property="BorderBrush" Value="#697185"/>
      <Setter Property="Padding" Value="10"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E3E5F1"/>
    </Style>
  </Application.Resources>
</Application>
