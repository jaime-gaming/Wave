<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Wave.Windows.MainWindow" Title="Wave" Icon="/Wave.ico" Width="1280" Height="860" MinWidth="800" MinHeight="600" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="{StaticResource WaveFont}" FontSize="15" Closing="ClosingWindow" PreviewKeyDown="WindowKey">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarWidth" Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="MiniHeight" Height="0"/></Grid.RowDefinitions>

    <!-- The rail: the wordmark, four destinations, the collection it holds. The
         selected item is the only one with a filled background, so the rail reads
         as a list of places rather than a column of buttons. -->
    <ScrollViewer x:Name="NavigationPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16,24,12,18">
        <!-- The wordmark, drawn with the same pen as the web build: one path, so the
             name is Wave's lettering rather than a font that happens to be nearby. -->
        <Viewbox Width="86" Height="20" HorizontalAlignment="Left" Margin="12,6,0,28" Stretch="Uniform">
          <Canvas Width="108" Height="20">
            <Path Canvas.Left="-1" Canvas.Top="-6" Stroke="{DynamicResource AccentBrush}" StrokeThickness="4.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Data="M4 8.6C7 8.6 7 23.4 12 23.4C17 23.4 17 8.6 20 8.6C23 8.6 23 23.4 28 23.4C33 23.4 33 8.6 36 8.6 M59 9.4v13.2 M52 9a7 7 0 1 0 0 14a7 7 0 0 0 0-14 M67 9.2L75 23L83 9.2 M91.06 16.9H104.9 M104.9 16.9A7 7 0 1 0 101.84 21.87"/>
          </Canvas>
        </Viewbox>
        <Button Style="{StaticResource NavButton}" Tag="Home" Click="NavigateClick">
          <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconHome}"/><TextBlock Text="Home" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Tag="Search" Click="NavigateClick">
          <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconSearch}"/><TextBlock Text="Search" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Tag="Library" Click="NavigateClick">
          <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconLibrary}"/><TextBlock Text="Library" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Tag="Remix" Click="NavigateClick">
          <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconRemix}"/><TextBlock Text="Remix" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <TextBlock Text="YOUR COLLECTION" Foreground="{DynamicResource MutedBrush}" Margin="14,24,0,8" FontSize="11" FontWeight="Bold" Opacity="0.85"/>
        <Button Style="{StaticResource NavButton}" Tag="Albums" Click="NavigateClick">
          <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconDisc}"/><TextBlock Text="Albums" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Tag="Artists" Click="NavigateClick">
          <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconArtist}"/><TextBlock Text="Artists" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Tag="Playlists" Click="NavigateClick">
          <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconQueue}"/><TextBlock Text="Playlists" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Tag="Favorites" Click="NavigateClick">
          <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconHeart}"/><TextBlock Text="Favorites" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Tag="Settings" Click="NavigateClick" Margin="0,20,0,0">
          <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconSettings}"/><TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <TextBlock Text="0.1.1" Foreground="{DynamicResource MutedBrush}" Margin="14,16,0,0" FontSize="12" Opacity="0.8"/>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Column="1" Margin="10,22,22,10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- One banner: the page name and its numbers on the left, the two utilities
           on the right, level with the title. Nothing above them is reserved. -->
      <Grid x:Name="PageHeader" Margin="8,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="Heading" Text="Home" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock x:Name="Summary" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="1,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Style="{StaticResource HeaderIconButton}" Click="ImportClick" ToolTip="Add music" Margin="0,0,8,0">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}"/>
          </Button>
          <Button Style="{StaticResource HeaderIconButton}" Tag="Settings" Click="NavigateClick" ToolTip="Settings">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSettings}"/>
          </Button>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="28" Padding="8,10,4,10">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock x:Name="Message" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="16,4,16,8" Visibility="Collapsed"/>
          <Grid Grid.Row="1">
            <Grid x:Name="LibraryView">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <!-- The page's own opening: headings, shelves, tabs. It never grows a
                   scrollbar of its own next to the list; see LayoutPage. -->
              <ScrollViewer x:Name="HeaderScroll" VerticalScrollBarVisibility="Auto" Padding="12,0,10,0">
                <StackPanel x:Name="CollectionHeader"/>
              </ScrollViewer>
              <ListBox x:Name="Songs" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="6,0,4,4" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" MouseDoubleClick="SongDoubleClick">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Row" Background="Transparent" CornerRadius="16" Padding="6,4">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource TonalBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource TonalBrush}"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TonalBrush}" CornerRadius="12" Width="44" Height="44" Tag="{Binding}" Cursor="Hand" MouseLeftButtonUp="ArtworkPlayClick">
                          <Grid>
                            <TextBlock Text="♪" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <Border CornerRadius="12"><Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill"/></Border.Background></Border>
                          </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                          <Button Content="{Binding Title}" Tag="{Binding}" Click="SongPlayClick" Style="{StaticResource TextButton}" FontSize="15" FontWeight="SemiBold" ToolTip="{Binding Title}"/>
                          <Button Content="{Binding Artist}" Tag="{Binding}" Click="SongArtistClick" Style="{StaticResource TextButton}" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                      </Grid>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding Album}" Tag="{Binding}" Click="SongAlbumClick" Style="{StaticResource TextButton}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,14,0" MaxWidth="180" ToolTip="{Binding Album}"/>
                        <Button Tag="{Binding}" Click="SongFavoriteClick" ToolTip="Toggle favorite" Width="36" Height="36" MinWidth="36" MinHeight="36">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Favorite}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource AccentTonalBrush}"/>
                                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                          <Path Data="{StaticResource IconHeart}" Style="{StaticResource IconPath}" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" Click="SongOptionsClick" ToolTip="Song options" Width="36" Height="36" MinWidth="36" MinHeight="36">
                          <TextBlock Text="⋯" FontSize="19" VerticalAlignment="Center"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="12,0,8,0">
              <StackPanel x:Name="SettingsBody"/>
            </ScrollViewer>

            <Grid x:Name="NowView" Visibility="Collapsed" Margin="14,6,12,6">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel>
                <Button Style="{StaticResource IconButton}" Click="CollapseClick" ToolTip="Close the player" DockPanel.Dock="Left">
                  <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronDown}"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="QueueClick" ToolTip="Queue" DockPanel.Dock="Right" HorizontalAlignment="Right">
                  <Path Style="{StaticResource IconPath}" Data="{StaticResource IconQueue}"/>
                </Button>
                <TextBlock Text="Now playing" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
              </DockPanel>
              <Grid Grid.Row="1" Margin="0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="LyricsWidth" Width="*"/></Grid.ColumnDefinitions>
                <Grid Margin="16" SizeChanged="ArtHostChanged">
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Border x:Name="NowArt" MouseLeftButtonUp="ToggleArtwork" Cursor="Hand" MaxWidth="430" MaxHeight="430" CornerRadius="32" Background="{DynamicResource TonalBrush}" HorizontalAlignment="Center">
                    <TextBlock x:Name="ArtPlaceholder" Text="♪" FontSize="96" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                  </Border>
                  <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock x:Name="NowTitle" FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                    <Button x:Name="NowArtist" Click="NowArtistClick" Style="{StaticResource TextButton}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
                <ScrollViewer x:Name="LyricsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="14">
                  <StackPanel x:Name="LyricsLines"/>
                </ScrollViewer>
              </Grid>
              <StackPanel Grid.Row="2" Margin="6,0,6,4">
                <Slider x:Name="Seek" Style="{StaticResource WaveSlider}" Minimum="0" Maximum="1" PreviewMouseLeftButtonUp="SeekReleased" PreviewKeyUp="SeekKey"/>
                <DockPanel Margin="2,0,2,6">
                  <TextBlock x:Name="Elapsed" Text="0:00" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock x:Name="Duration" Text="0:00" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                </DockPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Click="ShuffleClick" ToolTip="Shuffle">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconShuffle}"/>
                    </Button>
                    <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Click="RepeatClick" ToolTip="Repeat: off">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRepeat}"/>
                    </Button>
                    <Button x:Name="FavoriteButton" Style="{StaticResource IconButton}" Click="FavoriteClick" ToolTip="Favorite">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconHeart}"/>
                    </Button>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="PreviousClick" ToolTip="Previous">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPrevious}"/>
                    </Button>
                    <Button x:Name="NowToggle" Style="{StaticResource PlayButton}" Click="ToggleClick" ToolTip="Play" Margin="8,0">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlay}" Width="22" Height="22"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="NextClick" ToolTip="Next">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconNext}"/>
                    </Button>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Click="LyricsToggleClick" ToolTip="Lyrics">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconLyrics}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="EditClick" ToolTip="Edit song and lyrics">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconEdit}"/>
                    </Button>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- The dock: what is playing, its controls, and nothing else. -->
    <Border x:Name="MiniPlayer" Grid.Row="1" Grid.Column="1" Background="{DynamicResource TonalBrush}" CornerRadius="22" Margin="10,0,22,10" Visibility="Collapsed">
      <Grid Margin="10,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Click="NowClick" Background="Transparent" HorizontalContentAlignment="Stretch" Padding="4,2" Margin="0" ToolTip="Open the player">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="MiniArt" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource SurfaceBrush}">
              <TextBlock Text="♪" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="MiniTitle" FontWeight="Bold" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="MiniArtist" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Grid>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="MiniToggle" Style="{StaticResource PlayButton}" Click="ToggleClick" ToolTip="Play" Width="44" Height="44" MinWidth="44" MinHeight="44" Margin="4,0">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlay}" Width="18" Height="18"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Click="NextClick" ToolTip="Next">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconNext}"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Click="QueueClick" ToolTip="Queue">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconQueue}"/>
          </Button>
          <Slider x:Name="Volume" Style="{StaticResource WaveSlider}" Width="96" Minimum="0" Maximum="1" ValueChanged="VolumeChanged" VerticalAlignment="Center" Margin="10,0,4,0" ToolTip="Volume"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
